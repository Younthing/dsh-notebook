{
  "name": "@deepseek-ai/dsh-notebook-workspace",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run build:types && tsdown && pnpm --filter @deepseek-ai/dsh-client-ui-notebook run bundle",
    "build:types": "tsc -b tsconfig.host.json && tsc -b tsconfig.client.json",
    "clean": "rimraf coverage packages/*/lib",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "publint": "pnpm -r --if-present exec publint",
    "pack:verify": "tsx scripts/verify-packages.ts",
    "check": "pnpm run typecheck && pnpm run test:coverage && pnpm run lint && pnpm run build && pnpm run publint && pnpm run pack:verify"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "oxlint": "1.76.0",
    "publint": "^0.3.21",
    "rimraf": "^6.1.2",
    "tsdown": "^0.22.2",
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
