{
  "name": "@younthing/dsh-notebook-core",
  "description": "Durable notebook document and kernel orchestration service for DeepSeek Harness",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Younthing/dsh-notebook.git",
    "directory": "packages/notebook-core"
  },
  "homepage": "https://github.com/Younthing/dsh-notebook#readme",
  "bugs": "https://github.com/Younthing/dsh-notebook/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-brand": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-timeout": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1-rc.4"
  },
  "dependencies": {
    "@younthing/dsh-notebook-environment": "workspace:^",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/cordis": "4.0.1-rc.4"
  }
}
