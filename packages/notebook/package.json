{
  "name": "@younthing/dsh-notebook",
  "description": "Installable Notebook plugin bundle for DeepSeek Harness",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Younthing/dsh-notebook.git",
    "directory": "packages/notebook"
  },
  "homepage": "https://github.com/Younthing/dsh-notebook#readme",
  "bugs": "https://github.com/Younthing/dsh-notebook/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@younthing/dsh-client-ui-notebook": "workspace:^",
    "@younthing/dsh-notebook-core": "workspace:^",
    "@younthing/dsh-notebook-environment": "workspace:^",
    "@younthing/dsh-notebook-environment-uv": "workspace:^",
    "@younthing/dsh-notebook-kernel-jupyter": "workspace:^",
    "@younthing/dsh-notebook-remote": "workspace:^",
    "@younthing/dsh-tool-notebook": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.4",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6"
  }
}
